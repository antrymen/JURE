    "batch_field": {
      "title": "Batch Field",
      "type": "string"
    },
    "replicate_field": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Replicate Field"
    },
    "condition_type": {
      "title": "Condition Type",
      "type": "string"
    },
    "gene_mapping": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Gene Mapping",
      "type": "object"
    },
    "binarization_rule": {
      "const": "count_gt_zero",
